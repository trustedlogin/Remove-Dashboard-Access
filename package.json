{
  "name": "remove-dashboard-access",
  "version": "1.3.0",
  "private": true,
  "description": "Dev tooling for Remove Dashboard Access. Powered by @wordpress/scripts + @wordpress/env.",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.trustedlogin.com/remove-dashboard-access/",
  "scripts": {
    "env": "wp-env",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:clean": "wp-env clean all",
    "env:destroy": "wp-env destroy",
    "env:logs": "wp-env logs",
    "install:deps": "wp-env run tests-cli --env-cwd=wp-content/plugins/Remove-Dashboard-Access -- composer install",
    "lint:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/Remove-Dashboard-Access -- ./vendor/bin/phpcs",
    "lint:php:fix": "wp-env run tests-cli --env-cwd=wp-content/plugins/Remove-Dashboard-Access -- ./vendor/bin/phpcbf",
    "test": "npm run test:unit:php",
    "test:unit:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/Remove-Dashboard-Access -- ./vendor/bin/phpunit",
    "test:unit:php:coverage": "wp-env run tests-cli --env-cwd=wp-content/plugins/Remove-Dashboard-Access -- ./vendor/bin/phpunit --coverage-text",
    "screenshots": "playwright test --config=playwright.config.js",
    "screenshots:headed": "playwright test --config=playwright.config.js --headed",
    "screenshots:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@wordpress/env": "^10.10.0",
    "@wordpress/scripts": "^30.5.0"
  }
}
